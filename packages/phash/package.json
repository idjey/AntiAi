{
    "name": "@antiai/phash",
    "version": "0.1.0",
    "private": true,
    "description": "Perceptual hashing utilities for AntiAI.me (Server-Side ONLY)",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": "./dist/index.js",
        "./browser": "./dist/browser.js"
    },
    "scripts": {
        "build": "tsc && esbuild src/browser.ts --bundle --outfile=dist/extract.bundle.js --global-name=PhashExtract --format=iife",
        "clean": "rimraf dist"
    },
    "dependencies": {
        "blockhash-core": "^0.1.0",
        "canvas": "^3.2.3",
        "sharp": "^0.33.5"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.0",
        "@types/node": "^20.11.0",
        "esbuild": "^0.18.20",
        "playwright": "^1.62.0",
        "rimraf": "^5.0.5",
        "typescript": "^5.3.3"
    }
}
